<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="0dp"
    android:paddingEnd="0dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/widget_row_pending">

        <TextView
            android:id="@+id/widget_item_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#203A57"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/widget_equipment_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="#8293A6"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_details_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#203A57"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

        <LinearLayout
            android:id="@+id/widget_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp">

            <Button
                android:id="@+id/widget_action_status"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1.5"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:text="OZNACZ WYDANE"
                android:textAllCaps="false"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/widget_action_sms"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginLeft="5dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:text="SMS"
                android:textAllCaps="false"
                android:textSize="10sp" />

            <Button
                android:id="@+id/widget_action_call"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginLeft="5dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:text="ZADZWOŃ"
                android:textAllCaps="false"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>