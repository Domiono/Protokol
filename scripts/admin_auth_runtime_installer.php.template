<?php
declare(strict_types=1);
header('Content-Type: application/json; charset=utf-8');
header('Cache-Control: no-store');
$token=(string)($_SERVER['HTTP_X_RENTMOR_PROBE']??'');
if (($_SERVER['REQUEST_METHOD']??'')!=='POST' || $token==='' ||
    !hash_equals('__AUTH_HASH__',hash('sha256',$token))) {http_response_code(404);exit;}
function finish(bool $okay): never {
    http_response_code($okay?200:503);
    echo json_encode(['ok'=>$okay,'php_readable'=>$okay]);
    exit;
}
$raw=@file_get_contents('php://input');
if (!is_string($raw)||strlen($raw)>2048)finish(false);
$wanted=json_decode($raw,true);
if(!is_array($wanted))finish(false);
$root=dirname(__DIR__).'/rentmor-private';
$path=$root.'/admin-security.json';
$valid=static function($data): bool {
    return is_array($data) && is_string($data['password_hash']??null)
        && preg_match('/^\$2[aby]\$\d{2}\$[.\/A-Za-z0-9]{53}$/D',$data['password_hash'])===1
        && is_string($data['totp_secret']??null)
        && ($data['totp_secret']==='' || preg_match('/^[A-Z2-7]{32}$/D',$data['totp_secret'])===1);
};
$current=@file_get_contents($path);
$existing=$current!==false?json_decode($current,true):null;
if ($valid($existing)) {
    // Never overwrite a current password or enrolled 2FA key from an old SFTP snapshot.
    if (isset($wanted['password_hash']) && $wanted!==$existing)finish(false);
    finish(true);
}
if (!$valid($wanted))finish(false);
if (!is_dir($root) || !is_writable($root))finish(false);
$json=json_encode(['password_hash'=>$wanted['password_hash'],'totp_secret'=>$wanted['totp_secret']],JSON_UNESCAPED_SLASHES);
if ($json===false)finish(false);
$temp=$root.'/admin-config-'.bin2hex(random_bytes(12)).'.tmp';
if (@file_put_contents($temp,$json,LOCK_EX)!==strlen($json)){@unlink($temp);finish(false);}
@chmod($temp,0600);
if (!@rename($temp,$path)) {@unlink($temp);finish(false);}
$read=@file_get_contents($path);
finish(is_string($read) && hash_equals($json,$read));
