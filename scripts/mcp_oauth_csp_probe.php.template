<?php
declare(strict_types=1);
/** Ephemeral probe for exact live CSP headers. No OAuth credentials accessed. */
$provided=(string)($_SERVER['HTTP_X_RENTMOR_CSP_DIAG']??'');
if(($_SERVER['REQUEST_METHOD']??'')!=='POST' ||
    strlen($provided)!==64 ||
    !hash_equals('__TOKEN_HASH__',hash('sha256',$provided))) {
    http_response_code(404);
    exit;
}
require_once __DIR__.'/oauth_core.php';
// Exercise the SAME CSP decision as GET /oauth.php?op=authorize, without OAuth state.
$_SERVER['SCRIPT_NAME']='/rentmor-control-mcp/oauth.php';
$_SERVER['REQUEST_METHOD']='GET';
$_GET['op']='authorize';
rm_html_head();
header('Content-Type: text/plain; charset=utf-8');
echo "CSP checked";
